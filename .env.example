# Copy to .env. Everything has a working default: `docker compose up` runs fully offline.

# fake = offline rule-based stand-ins for both models (no key, no network); real = OpenRouter
LLM_MODE=fake
# Needed only for LLM_MODE=real. Never commit a real key.
OPENROUTER_API_KEY=
# System 2: tool-calling agent (any OpenRouter model with tool support)
AGENT_MODEL=openai/gpt-6-luna
# System 1: TypeSafe Jev via the OpenRouter Decisions API
CLASSIFIER_MODEL=~typesafe/jev-latest

# agent (default) = the tool-calling agent decides every ticket
# jev_first (opt-in) = Jev decides confident reply/escalate/close tickets, the agent handles the rest
DECIDER=agent
# jev_first only: every Jev answer the decision depends on must reach this confidence, otherwise the agent decides
JEV_MIN_CONFIDENCE=0.8
# How long a refund waits for a person before it is escalated (seconds; 86400 = 24h)
APPROVAL_TIMEOUT_SECONDS=86400

# Share of fake Helpdesk calls that fail with a temporary error (0.0 - 1.0)
HELPDESK_FAILURE_RATE=0.2
# SQLite file of completed Helpdesk actions (idempotency); shared by all workers
HELPDESK_STORE=helpdesk.sqlite3

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TASK_QUEUE=tickets
LOG_LEVEL=INFO
PYDANTIC_AI_NO_BANNER=1

# Host port for the API in docker compose
API_PORT=8000
